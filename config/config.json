{
  "regions": {
    "cn": {
      "qlib_data_path": "/data/qlib_data/qlib_bin/market_daily/cn/",
      "market": "all",
      "benchmark": "000300.sh",
      "industry_csv_path": "/data/qlib_data/standard_csv/industry_reference/cn/symbol_industry.csv",
      "price_adjustment": "qfq",
      "ohlcv_fields": {
        "open": "$open/$factor",
        "high": "$high/$factor",
        "low": "$low/$factor",
        "close": "$close/$factor",
        "pct_chg": "$pct_chg"
      },
      "tech_fields": {
        "volume": "$volume*$factor/1000000",
        "amount": "$amount*1000",
        "turnover": "$turnover*100",
        "change": "$change",
        "volume_ratio": "$volume_ratio",
        "dividends": "$dividends",
        "total_mv": "$total_mv",
        "circ_mv": "$circ_mv",
        "pe": "$pe_ttm",
        "pb": "$pb",
        "ps": "$ps_ttm",
        "dv_ttm": "$dv_ttm",
        "dv_ratio": "$dv_ratio",
        "earnings_yield": "1/($pe_ttm+1e-12)",
        "book_yield": "1/($pb+1e-12)",
        "pe_ma60": "Mean($pe_ttm, 60)",
        "pb_ma60": "Mean($pb, 60)",
        "pe_ma120": "Mean($pe_ttm, 120)",
        "pb_ma120": "Mean($pb, 120)",
        "pe_delta": "$pe_ttm-Ref($pe_ttm, 60)",
        "pb_delta": "$pb-Ref($pb, 60)",
        "ps_delta": "$ps_ttm-Ref($ps_ttm, 60)",
        "dv_delta": "$dv_ttm-Ref($dv_ttm, 60)"
      },
      "inject_pit_factors": false,
      "pit_factors": {
      },
      "pit_overlay_fields": [],
      "predictions": {
        "csi1000": "/data/win_share/csi1000_valueback"
      }
    },
    "hk": {
      "qlib_data_path": "/data/qlib_data/qlib_bin/market_daily/hk/",
      "market": "hsi",
      "benchmark": "HSI",
      "ohlcv_fields": {},
      "tech_fields": {}
    },
    "us": {
      "qlib_data_path": "/data/qlib_data/qlib_bin/market_daily/us/",
      "market": "sp500",
      "benchmark": "SPX",
      "ohlcv_fields": {},
      "tech_fields": {}
    }
  },
  "default_region": "cn"
}
